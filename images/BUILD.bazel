load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")

alias(
    name = "qemu",
    actual = select({
        "@platforms//cpu:x86_64": ":qemu_amd64",
        "@platforms//cpu:aarch64": ":qemu_arm64",
    }),
)

oci_image(
    name = "qemu_amd64",
    base = "@eclipse_autosd10_qemu_linux_amd64",
    tars = [
        "//src:hello_pkg_tar",
    ],
)

oci_image(
    name = "qemu_arm64",
    base = "@eclipse_autosd10_qemu_linux_arm64",
    tars = [
        "//src:hello_pkg_tar",
    ],
)
